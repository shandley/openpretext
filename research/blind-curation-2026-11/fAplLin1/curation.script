move scaffold_3.H2_1 to 49
move hap_scaffold_2.H1_1_1 to 50
# Haplotype-2 chromosomes that run opposite to their partner, turned round.
invert scaffold_1.H2_1_L
invert scaffold_5.H2_1
invert scaffold_2.H2_1_R
invert scaffold_13.H2_1
invert scaffold_14.H2_1
invert scaffold_12.H2_1
